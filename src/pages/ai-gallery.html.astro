---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const propLocale = Astro.props.locale;
const routeLocale = propLocale === 'fr' || propLocale === 'en' ? propLocale : 'ar';

const pageText = {
  ar: {
    dir: 'rtl',
    title: 'معرض الفيديوهات بالذكاء الاصطناعي',
    eyebrow: 'صناعة المحتوى بالذكاء الاصطناعي',
    heading: 'معرض الإنجازات سيضاف قريبًا',
    description:
      'هذه الصفحة جاهزة كمسار نشر، ويمكننا لاحقًا إضافة الفيديوهات والصور وروابط الأعمال النهائية داخلها.',
    projectDetails: 'الرجوع إلى تفاصيل المشروع',
  },
  fr: {
    dir: 'ltr',
    title: 'Galerie de vidéos créées avec l’IA',
    eyebrow: 'Création de contenu avec l’IA',
    heading: 'La galerie des réalisations sera bientôt ajoutée',
    description:
      'Cette page est prête comme espace de publication. Nous pourrons y ajouter plus tard les vidéos, les images et les liens vers les productions finales.',
    projectDetails: 'Retour aux détails du projet',
  },
  en: {
    dir: 'ltr',
    title: 'AI Video Gallery',
    eyebrow: 'AI Content Creation',
    heading: 'The achievements gallery will be added soon',
    description:
      'This page is ready as a publishing path. Later, we can add videos, images and links to the final works here.',
    projectDetails: 'Back to project details',
  },
} as const;

const text = pageText[routeLocale];
const projectHref =
  routeLocale === 'ar'
    ? getPermalink('/projects/ai-content-creation')
    : getPermalink(`/${routeLocale}/projects/ai-content-creation`);

const metadata = {
  title: text.title,
};
---

<Layout metadata={metadata}>
  <main class="min-h-[70vh] bg-slate-50 dark:bg-slate-950 py-16 md:py-24" dir={text.dir}>
    <section class="container mx-auto px-4 sm:px-6 max-w-3xl text-center">
      <span class="text-[#20A4F3] font-extrabold text-lg">{text.eyebrow}</span>
      <h1 class="mt-3 text-3xl md:text-5xl font-black text-slate-900 dark:text-white">
        {text.heading}
      </h1>
      <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
        {text.description}
      </p>

      <div class="mt-8">
        <a
          href={projectHref}
          class="inline-flex items-center justify-center rounded-xl bg-[#20A4F3] px-6 py-3 font-black text-[#0B1C4B] hover:bg-[#0B1C4B] hover:text-white transition-colors"
        >
          {text.projectDetails}
        </a>
      </div>
    </section>
  </main>
</Layout>

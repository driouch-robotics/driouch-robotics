---
import IaDayEdition1Page from '../ia-day-edition-1.astro';
import { locales } from '~/i18n/config';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'ar')
    .map((locale) => ({
      params: { locale },
    }));
}

const { locale } = Astro.params;
---

<IaDayEdition1Page locale={locale} />

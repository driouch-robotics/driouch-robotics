---
import AiGalleryPage from '../ai-gallery.html.astro';
import { locales } from '~/i18n/config';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'ar')
    .map((locale) => ({
      params: { locale },
    }));
}

const { locale } = Astro.params;
---

<AiGalleryPage locale={locale} />
